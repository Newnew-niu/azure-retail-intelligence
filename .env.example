# Copy to .env and adjust. .env is git-ignored - never commit real values.

# --- Local development (SQL Server Express LocalDB, Windows authentication: no password) ---
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=(localdb)\MSSQLLocalDB
SQL_DATABASE=retail_intelligence
# "windows" for LocalDB; "entra_interactive" for Azure SQL (signs in with your Microsoft Entra account)
SQL_AUTH=windows

# --- Azure (Stage 3) - names only, no keys. Authentication uses `az login` / managed identity. ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-retail-intel-dev
AZURE_STORAGE_ACCOUNT=
AZURE_SQL_SERVER=
