	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Data = Source{[Schema = "dw", Item = "dim_customer"]}[Data],
				    Selected = Table.SelectColumns(Data, {"customer_key", "customer_id", "customer_unique_id", "zip_code_prefix", "city", "state", "latitude", "longitude"})
