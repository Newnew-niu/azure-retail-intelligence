/// Calendar, one row per day (date_key = yyyymmdd)
table dim_date
	lineageTag: c03fcce2-05fa-54ac-ac41-a5e69582e473
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		lineageTag: 2be293dc-d5e9-5815-8da4-b257589204b5
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: b79c4214-9e09-5b77-abc0-fe211a553542
		summarizeBy: none
		sourceColumn: date

