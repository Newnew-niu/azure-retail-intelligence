	column 'In Reporting Window' = dim_date[date] >= DATE(2017, 1, 1) && dim_date[date] <= DATE(2018, 8, 31)
		dataType: boolean
		lineageTag: 7d5fd345-b8de-54fc-9e31-4c422d57f7f4
		summarizeBy: none

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Data = Source{[Schema = "dw", Item = "dim_date"]}[Data],
				    Selected = Table.SelectColumns(Data, {"date_key", "date", "year", "quarter", "month", "month_name", "year_month", "month_start", "day_of_month", "day_of_week", "day_name", "is_weekend"})
				in
				    Selected

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

