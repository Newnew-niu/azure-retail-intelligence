/// One row per order, with item/payment/review aggregates and delivery measures
table fact_orders
	lineageTag: 9496f354-0857-5a14-9c09-9e28a8588fb4

	/// Every order, whatever its status
	measure 'All Orders' = COUNTROWS(fact_orders)
		formatString: #,##0
		displayFolder: Orders
		lineageTag: 5ee32172-8b32-50c6-8696-dfb8592a3316

	/// Orders whose status is not canceled or unavailable
	measure 'Sales Orders' = CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(NOT fact_orders[order_status] IN {"canceled", "unavailable"}))
		formatString: #,##0
		displayFolder: Orders
		lineageTag: a14dd0e7-50e0-58af-a0c0-656090b65d3d

	/// Share of orders that were canceled or unavailable
	measure 'Canceled or Unavailable Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(fact_orders[order_status] IN {"canceled", "unavailable"})), [All Orders])
		formatString: 0.0%
		displayFolder: Orders
		lineageTag: 035b8b5b-5b5c-50e6-941d-40f1215a01f2

	/// Distinct people (customer_unique_id) with at least one sales order
	measure Customers = COUNTROWS(SUMMARIZE(CALCULATETABLE(fact_orders, KEEPFILTERS(NOT fact_orders[order_status] IN {"canceled", "unavailable"})), dim_customer[customer_unique_id]))
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 98807c27-87e5-5077-be05-ca7fa7305b1c

	/// Customers with more than one sales order in the selected period / customers
	measure 'Repeat Customer Rate' =
			VAR people =
			    ADDCOLUMNS(
			        SUMMARIZE(CALCULATETABLE(fact_orders, KEEPFILTERS(NOT fact_orders[order_status] IN {"canceled", "unavailable"})), dim_customer[customer_unique_id]),
			        "@orders", [Sales Orders])
			RETURN
			    DIVIDE(COUNTROWS(FILTER(people, [@orders] > 1)), COUNTROWS(people))
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 4443500b-dca5-51a6-ac04-b6fc2ee8791c

	/// (product sales + freight) / sales orders that have items, BRL
	measure 'Average Order Value' = DIVIDE([Product Sales] + [Freight], CALCULATE([Sales Orders], KEEPFILTERS(fact_orders[item_count] > 0)))
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: de3ddc83-dc04-5c4e-b6e4-65f6fb7a2a5f

	/// Status delivered and a customer delivery timestamp
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(fact_orders[is_delivered] = TRUE()))
		formatString: #,##0
		displayFolder: Delivery
		lineageTag: 7f5f44a4-519b-57cf-844d-f6093e20239e

	/// Purchase to customer delivery, delivered orders only
	measure 'Avg Delivery Days' = CALCULATE(AVERAGE(fact_orders[delivery_days]), KEEPFILTERS(fact_orders[is_delivered] = TRUE()))
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: e60bd486-2869-55d8-8b0f-240873f21737

	/// Purchase date to promised date, delivered orders only
	measure 'Avg Estimated Delivery Days' = CALCULATE(AVERAGE(fact_orders[estimated_delivery_days]), KEEPFILTERS(fact_orders[is_delivered] = TRUE()))
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 2af14b8d-3aa1-5911-abf3-9608f60ebda5

	/// Delivered after the estimated delivery date
	measure 'Late Deliveries' = CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(fact_orders[is_late] = TRUE()))
		formatString: #,##0
		displayFolder: Delivery
		lineageTag: 3aff15c1-293f-56ea-8949-ed171e2fd402

	/// Late deliveries / delivered orders
	measure 'Late Delivery Rate' = DIVIDE([Late Deliveries], [Delivered Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: e7173411-9fcd-5536-8ed9-a58fae75f48e

	/// Mean of the per-order average score (1-5), reviewed orders only
	measure 'Avg Review Score' = AVERAGE(fact_orders[review_score_avg])
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: b92d6d57-143c-507c-a18a-29fe48401a33

	/// Orders with at least one review
	measure 'Reviewed Orders' = CALCULATE(COUNTROWS(fact_orders), KEEPFILTERS(fact_orders[review_count] > 0))
		formatString: #,##0
		displayFolder: Reviews
		lineageTag: a4f120a9-1c75-5c9e-a059-b44a35bc3fd3

	column order_id
		dataType: string
		lineageTag: 8c6c47d1-f4cc-58ad-baf3-61602511c94d
