	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Data = Source{[Schema = "dw", Item = "fact_orders"]}[Data],
				    Selected = Table.SelectColumns(Data, {"order_id", "customer_key", "purchase_date_key", "order_status", "purchased_at", "delivered_customer_at", "estimated_delivery_date", "item_count", "items_price", "items_freight", "payment_count", "payment_value", "review_count", "review_score_avg", "delivery_days", "estimated_delivery_days", "delivery_vs_estimate_days", "is_delivered", "is_late", "delivery_status"})
				in
				    Selected

