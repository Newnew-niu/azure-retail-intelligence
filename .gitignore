# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and local configuration - never commit
.env
*.publishsettings
local.settings.json

# Source data (licensed CC BY-NC-SA 4.0; downloaded by scripts/download_data.py)
data/raw/*
!data/raw/.gitkeep
data/batches/
# Serving demo export and its KPI baseline, derived from the same licensed data
data/serving*

# Generated logs and reports
logs/

# Power BI temp/backup files (the .pbix itself IS committed)
*.pbix.bak
~$*

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Power BI project: local settings and the imported-data cache are not source
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf

# Power BI editor settings are local
powerbi/**/.pbi/editorSettings.json
