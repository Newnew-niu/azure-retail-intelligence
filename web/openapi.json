          },
          "review_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Score",
            "description": "Mean review score of orders with a review, 1 to 5"
          },
          "seller_id": {
            "type": "string",
            "title": "Seller Id"
          },
          "seller_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller State"
          }
        },
        "type": "object",
        "required": [
          "orders",
          "items_sold",
          "product_sales",
          "average_order_value",
          "late_rate",
          "review_score",
          "seller_id",
          "seller_state"
        ],
        "title": "SellerListItem"
      },
      "SellerMonth": {
        "properties": {
          "orders": {
            "type": "integer",
            "title": "Orders",
            "description": "Sales orders that include the seller's items"
          },
          "items_sold": {
            "type": "integer",
            "title": "Items Sold"
          },
          "product_sales": {
            "type": "number",
            "title": "Product Sales",
            "description": "Sum of item prices in BRL, excluding freight"
          },
          "average_order_value": {
