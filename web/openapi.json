{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail Intelligence Data API",
    "description": "Discover and query the governed datasets of the retail warehouse.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "description": "Liveness check, open without a key. It does not touch the database, so that it never\nwakes a paused serverless Azure SQL database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/datasets": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Datasets",
        "description": "List the datasets that can be queried.",
        "operationId": "list_datasets_datasets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DatasetSummary"
                  },
                  "type": "array",
                  "title": "Response List Datasets Datasets Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/datasets/{name}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Describe Dataset",
        "description": "Describe one dataset: columns, definitions, grain, source and row count.",
        "operationId": "describe_dataset_datasets__name__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown dataset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Run Query",
        "description": "Run one read-only SELECT on catalog datasets. Every attempt is audited.",
        "operationId": "run_query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "SQL rejected by a safety rule, or it failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Query cancelled by the timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/runs/latest": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Latest Run",
        "description": "Latest pipeline run and its data quality results.",
        "operationId": "latest_run_runs_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineStatus"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/sellers": {
      "get": {
        "tags": [
          "sellers"
        ],
        "summary": "List Sellers",
        "description": "Sellers with sales in the reporting window, with their KPIs. Empty KPIs sort last.",
        "operationId": "list_sellers_sellers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 25,
              "title": "Page Size"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Two-letter seller state",
              "title": "State"
            },
            "description": "Two-letter seller state"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{1,32}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start of the seller id",
              "title": "Q"
            },
            "description": "Start of the seller id"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "product_sales",
                "orders",
                "late_rate",
                "review_score"
              ],
              "type": "string",
              "default": "product_sales",
              "title": "Sort"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "desc",
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerPage"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Query cancelled by the timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sellers/{seller_id}": {
      "get": {
        "tags": [
          "sellers"
        ],
        "summary": "Get Seller",
        "description": "One seller: KPIs, a monthly trend and illustrative health signals (not a credit score).",
        "operationId": "get_seller_sellers__seller_id__get",
        "parameters": [
          {
            "name": "seller_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Seller Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerDetail"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Query cancelled by the timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No sales for this seller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Column": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "definition"
        ],
        "title": "Column"
      },
      "DataQuality": {
        "properties": {
          "summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Summary"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/QualityCheck"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "checks"
        ],
        "title": "DataQuality"
      },
      "DatasetDetail": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "grain": {
            "type": "string",
            "title": "Grain"
          },
          "layer": {
            "type": "string",
            "title": "Layer"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/Column"
            },
            "type": "array",
            "title": "Columns"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "grain",
          "layer",
          "owner",
          "source",
          "row_count",
          "columns"
        ],
        "title": "DatasetDetail"
      },
      "DatasetSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "grain": {
            "type": "string",
            "title": "Grain"
          },
          "layer": {
            "type": "string",
            "title": "Layer"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "grain",
          "layer",
          "owner"
        ],
        "title": "DatasetSummary"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "backend": {
            "type": "string",
            "title": "Backend"
          }
        },
        "type": "object",
        "required": [
          "status",
          "backend"
        ],
        "title": "Health"
      },
      "HealthSignal": {
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "sales_trend",
              "late_dispatch",
              "review_score"
            ],
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "status": {
            "type": "string",
            "enum": [
              "positive",
              "neutral",
              "attention",
              "insufficient_data"
            ],
            "title": "Status"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "Change, rate or score the status is based on"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "The result in one sentence, with the numbers behind it"
          },
          "rule": {
            "type": "string",
            "title": "Rule",
            "description": "The fixed rule and thresholds"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "status",
          "value",
          "summary",
          "rule"
        ],
        "title": "HealthSignal"
      },
      "PipelineRun": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "pipeline_name": {
            "type": "string",
            "title": "Pipeline Name"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "trigger_source": {
            "type": "string",
            "title": "Trigger Source"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "started_at_utc": {
            "type": "string",
