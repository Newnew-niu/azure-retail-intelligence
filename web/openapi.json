            "type": "integer",
            "title": "Orders",
            "description": "Sales orders that include the seller's items"
          },
          "items_sold": {
            "type": "integer",
            "title": "Items Sold"
          },
          "product_sales": {
            "type": "number",
            "title": "Product Sales",
            "description": "Sum of item prices in BRL, excluding freight"
          },
          "average_order_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
