            "type": "string",
            "title": "Seller Id"
          },
          "seller_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller State"
          },
          "window": {
            "$ref": "#/components/schemas/ReportingWindow"
          },
