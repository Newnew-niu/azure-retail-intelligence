          },
          "ended_at_utc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At Utc"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "pipeline_name",
          "batch_id",
          "trigger_source",
          "status",
          "started_at_utc",
          "ended_at_utc"
        ],
        "title": "PipelineRun"
      },
      "PipelineStatus": {
        "properties": {
          "latest_run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PipelineRun"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_quality": {
            "$ref": "#/components/schemas/DataQuality"
          }
        },
        "type": "object",
        "required": [
          "latest_run",
          "data_quality"
        ],
        "title": "PipelineStatus"
      },
      "QualityCheck": {
        "properties": {
          "check_name": {
            "type": "string",
            "title": "Check Name"
          },
          "check_category": {
            "type": "string",
            "title": "Check Category"
          },
          "target_object": {
            "type": "string",
            "title": "Target Object"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "failed_rows": {
            "type": "integer",
            "title": "Failed Rows"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "check_name",
          "check_category",
          "target_object",
          "severity",
          "failed_rows",
          "status",
          "description"
        ],
        "title": "QualityCheck"
      },
      "QueryRequest": {
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1,
            "title": "Sql",
            "description": "One SELECT in DuckDB dialect, using schema.table names."
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit",
            "description": "Maximum rows; default 500."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sql"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "row_limit": {
            "type": "integer",
            "title": "Row Limit"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "columns",
          "rows",
          "row_count",
          "row_limit",
          "truncated",
          "duration_ms"
        ],
        "title": "QueryResponse"
      },
