          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/HealthSignal"
            },
            "type": "array",
            "title": "Signals"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "seller_id",
          "seller_state",
          "window",
          "summary",
          "monthly",
          "signals",
          "disclaimer"
        ],
        "title": "SellerDetail"
      },
      "SellerListItem": {
        "properties": {
